# Local credentials
/.env

# Python / test caches
__pycache__/
*.pyc
.pytest_cache/

# Baseline run artifacts: keep CSV/JSON records, not checkpoints (multi-GB replay) or W&B caches
run_scripts/baseline/results/**/checkpoints/
run_scripts/baseline/results/**/wandb/
run_scripts/tuning/results/**/checkpoints/
run_scripts/tuning/results/**/_wb/
run_scripts/tuning/results/**/logs/
# Diagnostic raw runs stay local; the compact CSV/JSON evidence bundle is committed.
run_scripts/tuning/results/v3/smoke/
run_scripts/tuning/results/rt/
run_scripts/tuning/results/r?????/
# Stress runs: keep CSV/JSON records; never checkpoints/policies, W&B caches, logs, smoke or rehearsal roots
run_scripts/stress/results/**/checkpoints/
run_scripts/stress/results/**/_wb/
run_scripts/stress/results/**/logs/
run_scripts/stress/results/v3/smoke/
run_scripts/stress/results/r?????/
run_scripts/stress/results/pf*/

# Launch guides are filled in locally with SSH hosts, ports and keys: never commit them
**/PRODUCTION_LAUNCH*.md
