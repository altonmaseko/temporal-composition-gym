{
  "protocol_version": "v2",
  "phase": "baseline",
  "mode": "full",
  "env": {
    "key": "delivery",
    "id": "TemporalComp/HazardousDelivery-v0",
    "variant": "main",
    "kwargs": {
      "grid_size": 10,
      "percent_death_squares": 0.05,
      "percent_damage_squares": 0.05,
      "randomise_start": true,
      "randomise_goal": true,
      "num_packages": 3,
      "carrying_capacity": 1,
      "health_regeneration_nodes": 2,
      "task_dependencies": false,
      "include_health_in_state": true,
      "include_inventory_in_state": false,
      "max_steps": 500,
      "resample_unsolvable": true
    }
  },
  "algo": {
    "name": "dqn",
    "family": "memoryless",
    "impl": "sb3",
    "hyperparams": {
      "policy": "MlpPolicy",
      "gamma": 0.99,
      "buffer_size": 100000,
      "train_freq": 4,
      "gradient_steps": 1,
      "batch_size": 32,
      "exploration_initial_eps": 1.0,
      "exploration_final_eps": 0.05,
      "exploration_fraction": 0.2,
      "max_grad_norm": 10.0,
      "learning_rate": 0.0005,
      "learning_starts": 10000,
      "target_update_interval": 2000,
      "policy_kwargs": {
        "net_arch": [
          128,
          128
        ]
      }
    }
  },
  "seed": {
    "train_seed": 5,
    "train_env_reset_seed": 10005000
  },
  "budget": {
    "env_steps": 1000000
  },
  "eval": {
    "n_points": 20,
    "every_steps": 50000,
    "periodic_episodes": 50,
    "final_episodes": 200,
    "periodic_seed_block": "periodic",
    "final_seed_block": "final",
    "policy": "greedy (epsilon=0 / deterministic=True); recurrent state reset at episode start"
  },
  "checkpoint": {
    "every_steps": 100000,
    "save_replay": true
  },
  "logging": {
    "train_log_every_steps": 5000
  },
  "overrides": {},
  "wandb": {
    "project": "new_experiments",
    "entity": null,
    "group": "baseline-v2"
  }
}