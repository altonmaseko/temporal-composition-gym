{
  "protocol_version": "v2",
  "phase": "baseline",
  "mode": "full",
  "env": {
    "key": "colour",
    "id": "TemporalComp/SequentialColour-v0",
    "variant": "main",
    "kwargs": {
      "sequence_length_range": [
        3,
        5
      ],
      "retention_delay_steps": 2,
      "allow_consecutive_duplicates": false,
      "colour_vocabulary_size": 6,
      "randomise_wall_colors": true,
      "hard_death_mode": false,
      "infinite_mode": false,
      "reward_density": "sparse",
      "frames_per_colour": 5,
      "max_steps": 300
    }
  },
  "algo": {
    "name": "drqn",
    "family": "implicit",
    "impl": "custom",
    "hyperparams": {
      "encoder": "cnn",
      "enc_dim": 512,
      "lstm_dim": 256,
      "gamma": 0.99,
      "lr": 0.0001,
      "replay_frames": 100000,
      "learning_starts": 20000,
      "train_freq": 4,
      "target_update": 10000,
      "batch_size": 4,
      "train_len": 96,
      "burn_in": 32,
      "episode_start_fraction": 0.5,
      "eps_start": 1.0,
      "eps_end": 0.05,
      "eps_fraction": 0.2,
      "grad_clip": 10.0
    }
  },
  "seed": {
    "train_seed": 2,
    "train_env_reset_seed": 10002000
  },
  "budget": {
    "env_steps": 3000000
  },
  "eval": {
    "n_points": 20,
    "every_steps": 150000,
    "periodic_episodes": 50,
    "final_episodes": 200,
    "periodic_seed_block": "periodic",
    "final_seed_block": "final",
    "policy": "greedy (epsilon=0 / deterministic=True); recurrent state reset at episode start"
  },
  "checkpoint": {
    "every_steps": 300000,
    "save_replay": true
  },
  "logging": {
    "train_log_every_steps": 15000
  },
  "overrides": {},
  "wandb": {
    "project": "new_experiments",
    "entity": null,
    "group": "baseline-v2"
  }
}